# Optional: used to rewrite summaries for a specific job. Heuristic tailoring still works without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional third-party job API (https://developer.adzuna.com/). Leave blank to skip.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Slack app (chat.postMessage) — not a legacy custom incoming webhook.
# Create at https://api.slack.com/apps → OAuth & Permissions → Bot Token Scopes: chat:write
# Install to workspace, copy Bot User OAuth Token (xoxb-...), invite the bot to the channel.
SLACK_BOT_TOKEN=
# Channel ID (preferred, e.g. C0123456789) or #channel-name
SLACK_CHANNEL=
# Set to 0 to skip Slack when a scan finds no new roles.
SLACK_NOTIFY_EMPTY=1
